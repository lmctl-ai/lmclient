# DuckDB window functions reveal a cumulative energy budget.
mkdir("images"); mkdir("data"); mkdir("build");
dbhost = _dsl_ cli="lmclient" install="github:lmctl-ai/lmclient@latest";
let c = connect("jdbc:duckdb:");
c.exec("CREATE TABLE energy(day INT, kwh DOUBLE); INSERT INTO energy VALUES (1,14.2),(2,15.1),(3,13.7),(4,16.4),(5,18.0),(6,17.2),(7,15.8);");
let q = c.query("SELECT day, kwh, SUM(kwh) OVER (ORDER BY day) AS cumulative FROM energy");
q.csv("data/duckdb_energy.csv");
end _dsl_
savedsl(dbhost, "build/duckdb_energy.dslb");
r = system ${dsl_cli(dbhost)} --dsl build/duckdb_energy.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/duckdb_energy.csv"), false);
assert(rows.len() == 8);
assert(abs(num(rows[7][2]) - 110.4) < 0.001);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
let p = plot;
p.png("images/duckdb_energy.png", 900, 560); p.cmd("set title 'Weekly energy budget'; set xlabel 'Day'; set ylabel 'kWh'; set grid; set datafile separator ','; plot 'data/duckdb_energy.csv' every ::1 using 1:2 with boxes title 'daily', '' every ::1 using 1:3 with lines lw 3 title 'cumulative'"); p.close();
end _dsl_
savedsl(plot, "build/duckdb_energy_plot.dslb");
r = system ${dsl_cli(plot)} --dsl build/duckdb_energy_plot.dslb;
assert(r.code == 0);
