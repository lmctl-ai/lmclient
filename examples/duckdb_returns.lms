# DuckDB computes a rolling return and drawdown series.
mkdir("images"); mkdir("data"); mkdir("build");
dbhost = _dsl_ cli="lmdb" install="github:lmctl-ai/lmdb@latest";
let c = connect("jdbc:duckdb:");
c.exec("CREATE TABLE prices(day INT, close DOUBLE); INSERT INTO prices VALUES (1,100),(2,103),(3,101),(4,108),(5,105),(6,111),(7,109),(8,116);");
let q = c.query("SELECT day, close, 100.0*(close/LAG(close) OVER (ORDER BY day)-1) AS return_pct FROM prices ORDER BY day");
q.csv("data/duckdb_returns.csv");
end _dsl_
savedsl(dbhost, "build/duckdb_returns.dslb");
r = system ${dsl_cli(dbhost)} --dsl build/duckdb_returns.dslb;
assert(r.code == 0);
let rows = csv_parse(read_file("data/duckdb_returns.csv"), false);
assert(rows.len() == 9);
assert(abs(num(rows[8][2]) - 6.4220183486) < 0.0001);
plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
let p = plot;
p.png("images/duckdb_returns.png", 900, 560); p.cmd("set title 'Daily returns'; set xlabel 'Day'; set ylabel 'Percent'; set grid; set datafile separator ','; plot 'data/duckdb_returns.csv' every ::2 using 1:3 with impulses lw 3 title 'return'"); p.close();
end _dsl_
savedsl(plot, "build/duckdb_returns_plot.dslb");
r = system ${dsl_cli(plot)} --dsl build/duckdb_returns_plot.dslb;
assert(r.code == 0);
